{
  "manifest_version": 3,
  "name": "多线程下载 · 自动接管",
  "version": "1.1.2",
  "description": "用 aria2 多线程下载普通网页文件，支持暂停和切回 Chrome。",
  "key": "",
  "permissions": [
    "downloads",
    "nativeMessaging",
    "storage",
    "alarms",
    "webRequest"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "多线程下载"
  }
}
